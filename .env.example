# Copy to .env and adjust for local development.
# Never put real secrets in this file; .env is git-ignored.

# Backend URL that the Vite dev server proxies /api requests to.
BACKEND_URL=http://localhost:8000

# --- Contact API (backend) ---------------------------------------------------
# Without these settings the backend still starts, but POST /api/contact returns 503.
# Load them with: uv run --env-file ../.env uvicorn app.main:app --reload --port 8000

# Firestore project for local development (uses Application Default Credentials).
# On Cloud Run the project is detected automatically.
GOOGLE_CLOUD_PROJECT=

# Address that receives inquiry notifications. Never returned to clients.
CONTACT_NOTIFY_TO=
# OAuth client (Desktop app) used to send mail with the Gmail API. Not a secret.
GMAIL_OAUTH_CLIENT_ID=

# Secrets: set the value directly for local development, or set <NAME>_SECRET_VERSION
# to a Secret Manager version, e.g.
#   GMAIL_REFRESH_TOKEN_SECRET_VERSION=projects/<PROJECT_ID>/secrets/gmail-refresh-token/versions/latest
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Key for hashing client IP addresses in rate-limit records (any long random string).
CONTACT_IP_HASH_KEY=

# Rate limits (optional; defaults shown). Windows are UTC hours / UTC days.
# CONTACT_RATE_LIMIT_IP_PER_HOUR=3
# CONTACT_RATE_LIMIT_IP_PER_DAY=5
# CONTACT_RATE_LIMIT_SITE_PER_DAY=20

# Use the last X-Forwarded-For entry as the client IP. Defaults to true on Cloud Run
# (K_SERVICE is set) and false elsewhere. Only enable behind a trusted proxy.
# TRUST_X_FORWARDED_FOR=false
